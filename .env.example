# Chrome comum via CDP (mesmo mecanismo do RAC Position Tracker).
# O Shelf Proof usa porta e perfil PROPRIOS para nao disputar com o RAC no PC coletor.
RAC_LOCAL_CHROME=1
RAC_CDP_PORT=9223
# RAC_CHROME_PROFILE_DIR=C:\Users\ederr\Downloads\shelf-proof\data\chrome_profile_shelfproof
# RAC_CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe
# 0 = fecha o Chrome que este processo abriu ao terminar
RAC_LOCAL_CHROME_KEEP=1

# Fase 3: leitura visual do anunciante (--vision). Chave em console.anthropic.com.
# ANTHROPIC_API_KEY=
# SHELFPROOF_VISION_MODEL=claude-opus-5-5
